# Copy to .env in the repository root (optional). The API reads it on start; real environment variables win.
# API binds to loopback only (private-first). Do not expose on 0.0.0.0 without review.
AURORA_API_HOST=127.0.0.1
AURORA_API_PORT=3000
# Dev-server proxy target for the Angular app
AURORA_API_URL=http://127.0.0.1:3000

# ---- Persistence (M3) --------------------------------------------------------------------------
# PostgreSQL (recommended): start it with `npm run db:up` (Docker), then keep this line.
# Remove / comment it out to fall back to the local JSON file (apps/api/data/aurora-db.json).
DATABASE_URL=postgres://aurora:aurora@127.0.0.1:5432/aurora
# AURORA_PERSISTENCE=postgres      # force an adapter: postgres | json
# AURORA_DB_MIGRATE=auto           # auto: apply pending migrations on API start · off: refuse to start if pending
# AURORA_SEED=auto                 # auto: seed the "Coastal Air" demo into an empty database · off: start empty
# AURORA_DB_POOL_MAX=10
# Uploaded files are stored on disk for both adapters. Default: apps/api/data
# AURORA_DATA_DIR=./apps/api/data

# AI gateway: intentionally absent. M4 requires explicit approval of endpoint + data policy.
